index 0000000..83338e4
--- /dev/null
+++ b/lab/calendar_data_test.cpp
@@ -0,0 +1,51 @@
+#include <DateTime.h>
+#include <cassert>
+#include <cmath>
+#include <iostream>
+#include <limits>
+
+int main()
+{
+    unsigned checks = 0;
+    for (float scale : {0.f, 1.f, 10.f, 20.f, 1000.f})
+        for (unsigned month = 0; month < 12; ++month)
+            for (unsigned day = 1; day <= DateTime::GetNumberOfDaysByMonthIndex(month); ++day)
+                for (unsigned hours = 1; hours <= 24; ++hours)
+                {
+                    TimeModel initial;
+                    initial.Year = 201;
+                    initial.Month = month;
+                    initial.Day = day;
+                    initial.Time = 23.f;
+                    initial.TimeScale = scale;
+                    DateTime actual(initial);
+                    assert(actual.AdvanceRestHours(static_cast<float>(hours)));
+                    unsigned expectedDay = day + (23 + hours) / 24;
+                    unsigned expectedMonth = month;
+                    unsigned expectedYear = 201;
+                    if (expectedDay > DateTime::GetNumberOfDaysByMonthIndex(month))
+                    {
+                        expectedDay = 1;
+                        if (++expectedMonth == 12)
+                        {
+                            expectedMonth = 0;
+                            ++expectedYear;
+                        }
+                    }
+                    assert(std::abs(actual.m_timeModel.Time - (23 + hours) % 24) < 0.0001f);
+                    assert(actual.m_timeModel.Day == expectedDay);
+                    assert(actual.m_timeModel.Month == expectedMonth);
+                    assert(actual.m_timeModel.Year == expectedYear);
+                    assert(actual.m_timeModel.TimeScale == scale);
+                    ++checks;
+                }
+    for (float hours : {0.f, -1.f, 25.f, std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN()})
+    {
+        DateTime actual;
+        const TimeModel before = actual.m_timeModel;
+        assert(!actual.AdvanceRestHours(hours));
+        assert(actual.m_timeModel == before);
+        ++checks;
+    }
+    std::cout << "PASS: " << checks << " calendar cases\n";
+}
diff --git a/lab/campaign_cosave/Plugin.cpp b/lab/campaign_cosave/Plugin.cpp
new file mode 100644
index 0000000..27ec301
--- /dev/null
+++ b/lab/campaign_cosave/Plugin.cpp
@@ -0,0 +1,167 @@
+// SDK interfaces verified against ianpatt/skse64, PluginAPI.h and
+// Serialization.cpp. The downloaded SDK is a build dependency, not vendored.
+#include <Windows.h>
+#include <cstdint>
+#include <cstring>
+#include <cstdio>
+#include <charconv>
+#include <mutex>
+#include <atomic>
+using UInt32 = uint32_t;
+using UInt64 = uint64_t;
+#include <PluginAPI.h>
+#include <CampaignSave.h>
+
+namespace
+{
+std::mutex s_mutex;
+CampaignSave::Snapshot s_snapshot;
+CampaignSave::Barrier s_barrier{};
+bool s_loadedRecord{}, s_invalidRecord{};
+
+bool Uuid(const char* value, bool empty = false)
+{
+    if (empty && value[0] == 0) return true;
+    for (size_t i = 0; i < 36; ++i)
+    {
+        const char ch = value[i];
+        if (i == 8 || i == 13 || i == 18 || i == 23) { if (ch != '-') return false; }
+        else if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) return false;
+    }
+    return value[36] == 0;
+}
+bool Valid(const CampaignSave::Identity& record)
+{
+    return record.Version == CampaignSave::Schema && Uuid(record.Character)
+        && Uuid(record.Campaign, true) && Uuid(record.Epoch, true) && Uuid(record.Checkpoint, true);
+}
+void Generate()
+{
+    GUID guid{};
+    if (FAILED(CoCreateGuid(&guid))) { s_snapshot.Status = CampaignSave::Invalid; return; }
+    auto& record = s_snapshot.Record;
+    record = {};
+    std::snprintf(record.Character, sizeof(record.Character),
+        "%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x", guid.Data1, guid.Data2, guid.Data3,
+        guid.Data4[0], guid.Data4[1], guid.Data4[2], guid.Data4[3], guid.Data4[4], guid.Data4[5], guid.Data4[6], guid.Data4[7]);
+    // Initial enrollment is configured explicitly by the campaign manager.
+    constexpr auto ini = ".\\Data\\SKSE\\Plugins\\LoreRimCampaign.ini";
+    GetPrivateProfileStringA("Campaign", "Id", "", record.Campaign, sizeof(record.Campaign), ini);
+    GetPrivateProfileStringA("Campaign", "Epoch", "", record.Epoch, sizeof(record.Epoch), ini);
+    GetPrivateProfileStringA("Campaign", "Checkpoint", "", record.Checkpoint, sizeof(record.Checkpoint), ini);
+    char revision[32]{};
+    GetPrivateProfileStringA("Campaign", "Revision", "0", revision, sizeof(revision), ini);
+    const auto parsed = std::from_chars(revision, revision + std::strlen(revision), record.Revision);
+    if (parsed.ec != std::errc{} || *parsed.ptr != 0) { s_snapshot.Status = CampaignSave::Invalid; return; }
+    s_snapshot.Status = Valid(record) ? CampaignSave::NeedsSave : CampaignSave::Invalid;
+}
+void Invalidate(bool clearName)
+{
+    CampaignSave::Barrier callback;
+    {
+        std::lock_guard lock(s_mutex);
+        ++s_snapshot.Generation;
+        s_snapshot.Record = {}; s_snapshot.Status = CampaignSave::Loading;
+        if (clearName) s_snapshot.SaveName[0] = 0;
+        s_loadedRecord = s_invalidRecord = false;
+        callback = s_barrier;
+    }
+    // Never hold the companion lock while calling into the client.
+    if (callback) callback();
+}
+void Save(SKSESerializationInterface* api)
+{
+    std::lock_guard lock(s_mutex);
+    if (s_snapshot.Status == CampaignSave::Invalid || !Valid(s_snapshot.Record)) return;
+    if (!api->WriteRecord(CampaignSave::IdentityRecord, CampaignSave::Schema, &s_snapshot.Record, sizeof(s_snapshot.Record)))
+        s_snapshot.Status = CampaignSave::Invalid;
+    // A write callback is not proof the .ess/.skse pair finished. Require reload.
+}
+void Load(SKSESerializationInterface* api)
+{
+    std::lock_guard lock(s_mutex);
+    uint32_t type{}, version{}, length{};
+    while (api->GetNextRecordInfo(&type, &version, &length))
+    {
+        if (type != CampaignSave::IdentityRecord) continue;
+        CampaignSave::Identity record;
+        if (s_loadedRecord || s_invalidRecord || version != CampaignSave::Schema || length != sizeof(record)
+            || api->ReadRecordData(&record, sizeof(record)) != sizeof(record) || !Valid(record))
+        { s_invalidRecord = true; continue; }
+        s_snapshot.Record = record; s_loadedRecord = true;
+    }
+    if (s_invalidRecord) s_snapshot.Status = CampaignSave::Invalid;
+    else if (!s_loadedRecord) Generate();
+}
+void Revert(SKSESerializationInterface*) { Invalidate(false); }
+void Message(SKSEMessagingInterface::Message* message)
+{
+    if (!message) return;
+    switch (message->type)
+    {
+    case SKSEMessagingInterface::kMessage_PreLoadGame:
+        Invalidate(true);
+        if (message->data && message->dataLen && message->dataLen < sizeof(s_snapshot.SaveName))
+        {
+            std::lock_guard lock(s_mutex);
+            std::memcpy(s_snapshot.SaveName, message->data, message->dataLen);
+            s_snapshot.SaveName[message->dataLen] = 0;
+        }
+        break;
+    case SKSEMessagingInterface::kMessage_PostLoadGame:
+        {
+            std::lock_guard lock(s_mutex);
+            // SDK dispatches the success boolean encoded in the data pointer.
+            if (!message->data || s_invalidRecord) s_snapshot.Status = CampaignSave::Invalid;
+            else if (s_loadedRecord) s_snapshot.Status = CampaignSave::Ready;
+        }
+        break;
+    case SKSEMessagingInterface::kMessage_NewGame:
+        Invalidate(true);
+        { std::lock_guard lock(s_mutex); Generate(); }
+        break;
+    default: break;
+    }
+}
+}
+extern "C" __declspec(dllexport) bool LoreRimCampaign_Read(CampaignSave::Snapshot* out, uint32_t bytes)
+{
+    if (!out || bytes != sizeof(*out)) return false;
+    std::lock_guard lock(s_mutex); *out = s_snapshot; return true;
+}
+extern "C" __declspec(dllexport) bool LoreRimCampaign_RegisterBarrier(CampaignSave::Barrier callback)
+{
+    std::lock_guard lock(s_mutex); s_barrier = callback; return true;
+}
+extern "C" __declspec(dllexport) bool LoreRimCampaign_SetHead(uint64_t generation, const char* epoch, const char* checkpoint, uint64_t revision)
+{
+    if (!epoch || !checkpoint || !Uuid(epoch) || !Uuid(checkpoint, true)) return false;
+    std::lock_guard lock(s_mutex);
+    if (s_snapshot.Status != CampaignSave::Ready || s_snapshot.Generation != generation
+        || std::strcmp(s_snapshot.Record.Epoch, epoch) != 0) return false;
+    std::strncpy(s_snapshot.Record.Checkpoint, checkpoint, 36);
+    s_snapshot.Record.Checkpoint[36] = 0;
+    s_snapshot.Record.Revision = revision;
+    return true;
+}
+extern "C"
+{
+__declspec(dllexport) SKSEPluginVersionData SKSEPlugin_Version = {
+    SKSEPluginVersionData::kVersion, 4, "LoreRimCampaignCosave", "Codex", "",
+    SKSEPluginVersionData::kVersionIndependentEx_NoStructUse, 0,
+    {(1u << 24) | (6u << 16) | (1170u << 4), (1u << 24) | (7u << 16) | (104u << 4), 0}, 0};
+__declspec(dllexport) bool SKSEPlugin_Load(const SKSEInterface* skse)
+{
+    if (!skse || skse->isEditor) return false;
+    auto* serialization = static_cast<SKSESerializationInterface*>(skse->QueryInterface(kInterface_Serialization));
+    auto* messaging = static_cast<SKSEMessagingInterface*>(skse->QueryInterface(kInterface_Messaging));
+    if (!serialization || serialization->version < 4 || !messaging || messaging->interfaceVersion < 2) return false;
+    const auto handle = skse->GetPluginHandle();
+    if (handle == kPluginHandle_Invalid) return false;
+    serialization->SetUniqueID(handle, CampaignSave::PluginId);
+    serialization->SetRevertCallback(handle, Revert);
+    serialization->SetSaveCallback(handle, Save);
+    serialization->SetLoadCallback(handle, Load);
+    return messaging->RegisterListener(handle, "SKSE", Message);
+}
+}
diff --git a/lab/campaign_cosave/Probe.cpp b/lab/campaign_cosave/Probe.cpp
new file mode 100644
index 0000000..c2eb406
--- /dev/null
+++ b/lab/campaign_cosave/Probe.cpp
@@ -0,0 +1,109 @@
+// Pure SDK-serialization/ABI probe. Does not launch Skyrim or touch a profile.
+#include <Windows.h>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+#include <iostream>
+using UInt32=uint32_t; using UInt64=uint64_t;
+#include <PluginAPI.h>
+#include <CampaignSave.h>
+namespace
+{
+struct Chunk { uint32_t Type{},Version{}; std::vector<uint8_t> Bytes; };
+std::vector<Chunk> s_chunks, s_written;
+size_t s_next{},s_current{},s_offset{};
+SKSESerializationInterface::EventCallback s_save{},s_load{},s_revert{};
+SKSEMessagingInterface::EventCallback s_message{};
+uint32_t s_uid{},s_barriers{};
+CampaignSave::Read s_read{};
+SKSESerializationInterface s_serialization{};
+SKSEMessagingInterface s_messaging{};
+bool Write(uint32_t type,uint32_t version,const void* bytes,uint32_t length)
+{
+    const auto* data=static_cast<const uint8_t*>(bytes);
+    s_written.push_back({type,version,std::vector<uint8_t>(data,data+length)}); return true;
+}
+bool Next(uint32_t* type,uint32_t* version,uint32_t* length)
+{
+    if(s_next>=s_chunks.size())return false;
+    s_current=s_next++;s_offset=0;
+    *type=s_chunks[s_current].Type;*version=s_chunks[s_current].Version;*length=static_cast<uint32_t>(s_chunks[s_current].Bytes.size());return true;
+}
+uint32_t Read(void* buffer,uint32_t length)
+{
+    const auto& bytes=s_chunks[s_current].Bytes;
+    if(length>bytes.size()-s_offset)length=static_cast<uint32_t>(bytes.size()-s_offset);
+    std::memcpy(buffer,bytes.data()+s_offset,length);s_offset+=length;return length;
+}
+void Barrier()
+{
+    ++s_barriers;
+    CampaignSave::Snapshot current;
+    // A successful reentrant read proves the callback is not invoked under its lock.
+    if(s_read && !s_read(&current,sizeof(current)))std::terminate();
+}
+void Message(uint32_t type,void* data=nullptr,uint32_t size=0)
+{
+    SKSEMessagingInterface::Message message{"SKSE",type,size,data};s_message(&message);
+}
+void Reload(const std::vector<Chunk>& chunks)
+{
+    char name[]="FixtureSave";
+    Message(SKSEMessagingInterface::kMessage_PreLoadGame,name,sizeof(name)-1);
+    s_revert(&s_serialization);
+    s_chunks=chunks;s_next=s_offset=s_current=0;s_load(&s_serialization);
+    Message(SKSEMessagingInterface::kMessage_PostLoadGame,reinterpret_cast<void*>(1),1);
+}
+}
+#define CHECK(condition) do { if(!(condition)) { std::cerr<<"FAIL line "<<__LINE__<<"\n";return 1; } } while(0)
+int main(int argc,char** argv)
+{
+    if(argc!=2)return 2;
+    auto* module=LoadLibraryA(argv[1]);CHECK(module);
+    auto pluginLoad=reinterpret_cast<bool (*)(const SKSEInterface*)>(GetProcAddress(module,"SKSEPlugin_Load"));
+    auto* metadata=reinterpret_cast<SKSEPluginVersionData*>(GetProcAddress(module,"SKSEPlugin_Version"));
+    s_read=reinterpret_cast<CampaignSave::Read>(GetProcAddress(module,"LoreRimCampaign_Read"));
+    auto setHead=reinterpret_cast<CampaignSave::SetHead>(GetProcAddress(module,"LoreRimCampaign_SetHead"));
+    auto registerBarrier=reinterpret_cast<CampaignSave::RegisterBarrier>(GetProcAddress(module,"LoreRimCampaign_RegisterBarrier"));
+    CHECK(pluginLoad && metadata && metadata->dataVersion==1 && s_read && setHead && registerBarrier);
+    CHECK(registerBarrier(Barrier));
+    s_serialization.version=4;
+    s_serialization.SetUniqueID=[](PluginHandle,uint32_t uid){s_uid=uid;};
+    s_serialization.SetRevertCallback=[](PluginHandle,auto callback){s_revert=callback;};
+    s_serialization.SetSaveCallback=[](PluginHandle,auto callback){s_save=callback;};
+    s_serialization.SetLoadCallback=[](PluginHandle,auto callback){s_load=callback;};
+    s_serialization.WriteRecord=Write;s_serialization.GetNextRecordInfo=Next;s_serialization.ReadRecordData=Read;
+    s_messaging.interfaceVersion=2;
+    s_messaging.RegisterListener=[](PluginHandle,const char*,auto callback){s_message=callback;return true;};
+    SKSEInterface skse{};
+    skse.QueryInterface=[](uint32_t type)->void* {return type==kInterface_Serialization?static_cast<void*>(&s_serialization):type==kInterface_Messaging?static_cast<void*>(&s_messaging):nullptr;};
+    skse.GetPluginHandle=[]()->PluginHandle{return 1;};
+    CHECK(pluginLoad(&skse));CHECK(s_uid==CampaignSave::PluginId && s_save && s_load && s_revert && s_message);
+    CampaignSave::Identity identity;
+    std::strcpy(identity.Character,"11111111-1111-4111-8111-111111111111");
+    std::strcpy(identity.Campaign,"22222222-2222-4222-8222-222222222222");
+    std::strcpy(identity.Epoch,"33333333-3333-4333-8333-333333333333");
+    const auto* bytes=reinterpret_cast<const uint8_t*>(&identity);
+    Chunk record{CampaignSave::IdentityRecord,1,std::vector<uint8_t>(bytes,bytes+sizeof(identity))};
+    Reload({record});
+    CampaignSave::Snapshot snapshot;CHECK(s_read(&snapshot,sizeof(snapshot)));
+    CHECK(snapshot.Status==CampaignSave::Ready && std::strcmp(snapshot.SaveName,"FixtureSave")==0 && s_barriers==2);
+    CHECK(std::memcmp(&snapshot.Record,&identity,sizeof(identity))==0);
+    CHECK(!setHead(snapshot.Generation+1,identity.Epoch,"",0));
+    CHECK(!setHead(snapshot.Generation,identity.Campaign,"",0));
+    CHECK(setHead(snapshot.Generation,identity.Epoch,"44444444-4444-4444-8444-444444444444",99));
+    CHECK(setHead(snapshot.Generation,identity.Epoch,"",100));
+    s_save(&s_serialization);CHECK(s_written.size()==1 && s_written[0].Bytes.size()==160);
+    const auto saved=s_written;
+    Reload(saved);CHECK(s_read(&snapshot,sizeof(snapshot)) && snapshot.Status==CampaignSave::Ready && snapshot.Record.Revision==100);
+    Reload({record,record});CHECK(s_read(&snapshot,sizeof(snapshot)) && snapshot.Status==CampaignSave::Invalid);
+    auto malformed=record;malformed.Bytes.pop_back();Reload({malformed});CHECK(s_read(&snapshot,sizeof(snapshot)) && snapshot.Status==CampaignSave::Invalid);
+    Reload({});CHECK(s_read(&snapshot,sizeof(snapshot)) && snapshot.Status==CampaignSave::NeedsSave && std::strlen(snapshot.Record.Character)==36);
+    CHECK(!setHead(snapshot.Generation,identity.Epoch,"",0));
+    Message(SKSEMessagingInterface::kMessage_PreLoadGame);CHECK(s_read(&snapshot,sizeof(snapshot)) && snapshot.Status==CampaignSave::Loading);
+    CHECK(!s_read(&snapshot,sizeof(snapshot)-1));
+    CHECK(registerBarrier(nullptr));
+    std::cout<<"PASS: companion ABI, serialization roundtrip, preload invalidation, epoch checks, duplicate/truncated record rejection, legacy migration\n";
+    // Keep module loaded until process exit; callbacks point into it.
+    return 0;
+}
