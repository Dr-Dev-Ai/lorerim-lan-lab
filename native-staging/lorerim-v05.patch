@@ -0,0 +1,52 @@
+# Sync Health panel
+
+Read-only in-game timing and connection diagnostics. Default: compact while
+connected. F10 cycles compact, detailed, hidden. It does not capture mouse input.
+Optional settings: `Data/SKSE/Plugins/LoreRimSyncHealth.ini`; see the template.
+Position, scale, initial mode and toggle key apply at startup.
+
+The panel samples ECS/network state on UpdateEvent at most five times per second
+and renders a mutex-protected copy. Graphs keep 120 one-second samples. Only the
+five oldest remote actor streams are retained for display. Rendering never
+queries the ECS or calls actor movement functions. Interpolation diagnostics
+observe existing decisions without changing playback/correction behavior.
+
+- Ping and connection quality come from GameNetworkingSockets. Quality is
+  in-order delivery success, not a precise packet-loss counter.
+- Queue time and pending/unacknowledged reliable bytes describe local sending.
+- Actor age uses the networking receive clock, not a comparison between owner
+  and receiver clocks. Jitter/buffer use the existing per-actor playback clock.
+  Streams older than max(1000 ms, six snapshot intervals) are marked stale.
+  Zero remote samples can be normal on a server with one player.
+- Correction/snap totals cover currently monitored actors; totals may decrease
+  when actors unload or ownership changes. Teleports are excluded. Corrections
+  smaller than one game unit are not counted. Game units are not metres.
+- Update age can continue increasing in the rendering callback while game
+  updates stop. Update gaps above 250 ms also include expected loads and rests.
+- Time-of-day difference is an estimate against the last server calendar
+  report, advanced using its time scale and half the current ping. It is shown
+  after five seconds of settling. It does not compare calendar dates or prove
+  that the server clock is correct. Paired checkpoints and transitions may
+  legitimately change this estimate.
+- An online save load is logged and now closes the connection at the completed
+  load event, with a HUD explanation. A persistent disconnected notice remains
+  in the panel until reconnect, including when telemetry display is set to off.
+  No stale connection metrics are shown in that notice. It does not roll back the server or peers
+  to the save's inventory/quest state. Disconnect BEFORE loading and
+  use a save consistent with party progress before reconnecting. Campaign mode
+  additionally invalidates admission on load. The post-load disconnect is a
+  fallback boundary, not a transactional preload barrier or universal repair.
+
+Amber highlights timing/risk indicators, not a measured desync percentage.
+Server processing time and quest/inventory agreement are explicitly unmeasured.
+No new messages, protocol identity, server deployment or third-party plugin.
+True state comparisons and server processing telemetry require further work.
+
+Validation: native client compilation passed. Host runtime visibility and F10 compact/details/hidden modes passed. Detailed
+view was visually inspected: local ping0 ms, quality100%/100%, queue0 ms,
+pending reliable0 bytes, clock estimate+1.1 game seconds and client update4.8 ms.
+Two locally owned actors and no remote streams were present. Remote actor
+measurements and two-client behavior remain untested; the connected-load warning
+was not deliberately induced.
+No new gameplay unit tests were added. Existing source-level engine accessors
+are reused; no new binary patch, vtable slot or raw engine offset is introduced.
diff --git a/lab/test_party_rest.py b/lab/test_party_rest.py
new file mode 100644
index 0000000..c01f32c
--- /dev/null
+++ b/lab/test_party_rest.py
@@ -0,0 +1,164 @@
+import unittest
+from dataclasses import replace
+
+from party_rest import Party, PartyRest, RestError, ClientRestEffects
+
+
+class RestTests(unittest.TestCase):
+    def setUp(self):
+        self.party = Party(10, 1, 1, frozenset({1, 2}))
+        self.rest = PartyRest()
+
+    def begin(self, **kwargs):
+        n = self.rest.begin(self.party, 1, 8, 0, **kwargs)
+        for p in self.party.members:
+            self.rest.report_safe(n, self.party, p, 1, safe=True)
+        return n
+
+    def complete(self, n, **kwargs):
+        args = dict(completed_by=1, actual_hours=8,
+                    connected=self.party.members, current_safe=self.party.members)
+        args.update(kwargs)
+        return self.rest.complete(n, self.party, 5, **args)
+
+    def test_same_leader_duration_for_both(self):
+        result = self.complete(self.begin())
+        self.assertEqual([(b.player, b.hours) for b in result.benefits],
+                         [(1, 8), (2, 8)])
+        self.assertEqual(result.advance_hours, 0)
+
+    def test_nonleader_cannot_request_or_complete(self):
+        with self.assertRaises(RestError):
+            self.rest.begin(self.party, 2, 8, 0)
+        n = self.begin()
+        with self.assertRaises(RestError):
+            self.complete(n, completed_by=2)
+
+    def test_membership_change_cancels(self):
+        n = self.begin()
+        changed = replace(self.party, revision=2, members=frozenset({1, 3}))
+        with self.assertRaises(RestError):
+            self.rest.report_safe(n, changed, 1, 2, safe=True)
+        self.assertEqual(self.rest.active_count, 0)
+
+    def test_leader_change_cancels(self):
+        n = self.begin()
+        with self.assertRaises(RestError):
+            self.rest.report_safe(n, replace(self.party, leader=2), 2, 2, safe=True)
+        self.assertEqual(self.rest.active_count, 0)
+
+    def test_disconnect_and_interrupted_rest_do_not_award(self):
+        for overrides in (dict(connected=frozenset({1})), dict(actual_hours=1)):
+            self.setUp()
+            n = self.begin()
+            with self.assertRaises(RestError):
+                self.complete(n, **overrides)
+            self.assertEqual(self.rest.active_count, 0)
+
+    def test_recheck_combat_at_commit(self):
+        with self.assertRaises(RestError):
+            self.complete(self.begin(), current_safe=frozenset({1}))
+
+    def test_timeout_and_replay(self):
+        n = self.begin()
+        with self.assertRaises(RestError):
+            self.rest.report_safe(n, self.party, 1, 60, safe=True)
+        n = self.begin()
+        self.complete(n)
+        with self.assertRaises(RestError):
+            self.complete(n)
+
+    def test_skip_requires_everyones_consent(self):
+        n = self.begin(skip_time=True)
+        for p in self.party.members:
+            self.rest.consent_to_skip(n, self.party, p, 2, agree=True)
+        self.assertEqual(self.complete(n, world_consent=self.party.members).advance_hours, 8)
+
+    def test_missing_consent_grants_rest_without_skipping(self):
+        self.assertEqual(self.complete(self.begin(skip_time=True)).advance_hours, 0)
+
+    def test_other_party_is_never_time_skipped_without_consent(self):
+        n = self.begin(skip_time=True)
+        for p in self.party.members:
+            self.rest.consent_to_skip(n, self.party, p, 2, agree=True)
+        result = self.complete(n, connected=frozenset({1, 2, 3}),
+                               current_safe=frozenset({1, 2, 3}),
+                               world_consent=self.party.members)
+        self.assertEqual(result.advance_hours, 0)
+        self.assertEqual({b.player for b in result.benefits}, {1, 2})
+
+    def test_invalid_durations(self):
+        for hours in (0, -1, 25, float('nan'), float('inf')):
+            with self.assertRaises(RestError):
+                self.rest.begin(self.party, 1, hours, 0)
+
+
+class ClientMenuTests(unittest.TestCase):
+    setUp = RestTests.setUp
+    begin = RestTests.begin
+    complete = RestTests.complete
+
+    def delivery(self):
+        return self.complete(self.begin())
+
+    def test_each_player_checks_own_points(self):
+        result = self.delivery()
+        opened = []
+        rested = []
+        for player, points in ((1, 0), (2, 7)):
+            client = ClientRestEffects(player)
+            client.receive(result, apply_rest=lambda h: rested.append((player, h)))
+            client.poll_skill_menu(
+                bookkeeping_finished=True, can_open_menu=lambda: True,
+                get_spendable_points=lambda: points,
+                open_skill_menu=lambda: opened.append(player) or True)
+        self.assertEqual(rested, [(1, 8), (2, 8)])
+        self.assertEqual(opened, [2])
+
+    def test_waits_for_bookkeeping_and_safe_ui(self):
+        client = ClientRestEffects(1)
+        client.receive(self.delivery(), apply_rest=lambda h: None)
+        opened = []
+        def poll(done, safe):
+            return client.poll_skill_menu(
+                bookkeeping_finished=done, can_open_menu=lambda: safe,
+                get_spendable_points=lambda: 3,
+                open_skill_menu=lambda: opened.append(1) or True)
+        self.assertFalse(poll(False, True))
+        self.assertFalse(poll(True, False))
+        self.assertTrue(poll(True, True))
+        self.assertFalse(poll(True, True))
+        self.assertEqual(opened, [1])
+
+    def test_duplicate_delivery_does_not_reapply_or_reopen(self):
+        client = ClientRestEffects(1)
+        result = self.delivery()
+        calls = []
+        self.assertTrue(client.receive(result, apply_rest=calls.append))
+        self.assertFalse(client.receive(result, apply_rest=calls.append))
+        self.assertEqual(calls, [8])
+
+    def test_no_points_no_menu(self):
+        client = ClientRestEffects(1)
+        client.receive(self.delivery(), apply_rest=lambda h: None)
+        def forbidden():
+            self.fail("A character without points must not get a menu")
+        self.assertFalse(client.poll_skill_menu(
+            bookkeeping_finished=True, can_open_menu=lambda: True,
+            get_spendable_points=lambda: 0, open_skill_menu=forbidden))
+
+    def test_failed_open_retries_without_reapplying_rest(self):
+        client = ClientRestEffects(1)
+        applied = []
+        client.receive(self.delivery(), apply_rest=applied.append)
+        def poll(opener):
+            return client.poll_skill_menu(
+                bookkeeping_finished=True, can_open_menu=lambda: True,
+                get_spendable_points=lambda: 2, open_skill_menu=opener)
+        self.assertFalse(poll(lambda: False))
+        self.assertTrue(poll(lambda: True))
+        self.assertEqual(applied, [8])
+
+
+if __name__ == '__main__':
+    unittest.main()
