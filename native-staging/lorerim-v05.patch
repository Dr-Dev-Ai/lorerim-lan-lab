+    const size_t cOffset = VersionDb::Get().GetLoadedVersionString() == "1.6.1170.0" ? 0x680 : 0x690;
+    return *reinterpret_cast<const uint32_t*>(reinterpret_cast<const uint8_t*>(this) + cOffset) != 0;
+}
