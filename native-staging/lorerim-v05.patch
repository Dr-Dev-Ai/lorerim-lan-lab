+    RealLocalMap = reinterpret_cast<decltype(RealLocalMap)>(localMap.Get());
+    TP_HOOK(&RealLocalMap, UpdateLocalMap);
+    spdlog::info("Connected menus: 1170 deferred saves and main-thread UI installed");
+    return true;
+}
